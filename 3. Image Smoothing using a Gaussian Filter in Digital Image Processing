% Lab 1: Image Smoothing using Gaussian Filter
clc;
clear all;
close all;

I = checkerboard(20, 4, 4);

sigma_values = [1, 2, 5];

figure;
subplot(2,2,1);
imshow(I);
title('Original Checkerboard Image');

for i = 1:length(sigma_values)
    H = fspecial('gaussian', [5 5], sigma_values(i));
    I_smooth = conv2(I, H, 'same');
    subplot(2,2,i+1);
    imshow(I_smooth, []);
    title(['Smoothed, \sigma = ', num2str(sigma_values(i))]);
end

% Lab 2: Checkerboard Convolution with Gaussian Filter 
img = checkerboard(16, 4, 4);
h = fspecial('gaussian', [15 15], 5);
conv_result = conv2(img, h, 'same');

figure;
subplot(1,3,1);
imshow(img, []);
title('Original Checkerboard');

subplot(1,3,2);
imshow(h, []);
title('Gaussian Filter');

subplot(1,3,3);
imshow(conv_result, []);
title('Filtered (Smoothed) Image');

% Lab 3: Average Filter
clc;
clear all;
close all;

I = checkerboard(20, 4, 4);
filter_sizes = [3, 5, 9];

figure;
subplot(2,2,1);
imshow(I);
title('Original Checkerboard Image');

for i = 1:length(filter_sizes)
    H = fspecial('average', filter_sizes(i));
    I_smooth = conv2(I, H, 'same');
    subplot(2,2,i+1);
    imshow(I_smooth, []);
    title(['Smoothed, Avg Filter = ', num2str(filter_sizes(i)), '×', num2str(filter_sizes(i))]);
end



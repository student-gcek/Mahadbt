clc;
close all;
clear all;

I = imread('flower.png');
if size(I,3) == 3
    I = rgb2gray(I);
end

figure;
subplot(2,2,1);
imshow(I);
title('Original Grayscale Image');

[R, C] = size(I);
J = zeros(R,C,'uint8');
th = 100;

for x = 1:R
    for y = 1:C
        if I(x,y) >= th
            J(x,y) = 255;
        end
    end
end

subplot(2,2,2);
imshow(J);
title('Manual Thresholding (Loop-Based)');

K = imbinarize(I, th/255);
subplot(2,2,3);
imshow(K);
title('Manual Thresholding (imbinarize Function)');

T_otsu = graythresh(I);
L = imbinarize(I, T_otsu);
subplot(2,2,4);
imshow(L);
title(['Otsu Automated Thresholding (T = ', num2str(T_otsu*255, '%.2f'), ')']);

gray_image = checkerboard(16, 4, 4);
f_transform = fft2(gray_image);
f_shifted = fftshift(f_transform);
magnitude_spectrum = abs(f_shifted);
phase_spectrum = angle(f_shifted);
log_magnitude = log(magnitude_spectrum + 1);

figure('Name','FFT Analysis - Main View','NumberTitle','off');
subplot(2, 2, 1);
imshow(gray_image, []);
title('Original Image (Spatial Domain)');

subplot(2, 2, 2);
imshow(log_magnitude, []);
title('Magnitude Spectrum (Frequency Domain)');
xlabel('Low freq → center, High freq → edges');

subplot(2, 2, 3);
imshow(phase_spectrum, []);
title('Phase Spectrum');

reconstructed_image = ifft2(ifftshift(f_shifted));
subplot(2, 2, 4);
imshow(abs(reconstructed_image), []);
title('Reconstructed Image (Inverse FFT)');

figure('Name','FFT Phase Importance Demo','NumberTitle','off');
mag_only = magnitude_spectrum .* exp(1i * 0);
img_mag_only = ifft2(ifftshift(mag_only));

phase_only = exp(1i * phase_spectrum);
img_phase_only = ifft2(ifftshift(phase_only));

subplot(3, 1, 1);
imshow(abs(img_mag_only), []);
title('Reconstruction: Magnitude Only');

subplot(3, 1, 2);
imshow(abs(img_phase_only), []);
title('Reconstruction: Phase Only');

subplot(3, 1, 3);
imshow(gray_image, []);
title('Original Image');

